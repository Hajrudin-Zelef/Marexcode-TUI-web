#!/usr/bin/env python3
"""Administration de marexssh (à exécuter en root sur PVE)."""
import json
import os
import subprocess
import sys
import time

STATE = "/var/lib/marexssh"
KNOWN = os.path.join(STATE, "known_hosts.json")
AUDIT = os.path.join(STATE, "audit.jsonl")


def load():
    try:
        with open(KNOWN, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return {}
    except Exception as exc:
        print("Lecture impossible :", exc, file=sys.stderr)
        sys.exit(1)


def save(data):
    tmp = KNOWN + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, KNOWN)
    try:
        import pwd
        uid = pwd.getpwnam("marexssh").pw_uid
        gid = pwd.getpwnam("marexssh").pw_gid
        os.chown(KNOWN, uid, gid)
    except Exception:
        pass


def fmt(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)) if ts else "-"


def usage():
    print("""Usage : marexssh <commande>

  known-hosts            lister les clés d'hôte épinglées
  forget <hôte:port|all> oublier une clé (ou toutes) puis redémarrer le service
  audit [n]              afficher les n dernières lignes d'audit (défaut 50)
  status                 état du service
""")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "known-hosts":
        data = load()
        if not data:
            print("Aucune clé d'hôte.")
            return
        for host in sorted(data):
            entry = data[host]
            print("%-30s %-60s premier=%s dernier=%s" % (
                host, entry.get("fingerprint", "-"),
                fmt(entry.get("first_seen")), fmt(entry.get("last_seen"))))
        return
    if cmd == "forget":
        target = sys.argv[2] if len(sys.argv) > 2 else ""
        if not target:
            print("Usage : marexssh forget <hôte:port|all>", file=sys.stderr)
            sys.exit(1)
        data = load()
        if target == "all":
            data = {}
        else:
            data.pop(target, None)
        save(data)
        subprocess.run(["systemctl", "restart", "marexssh"], check=False)
        print("Clé oubliée (%s) ; marexssh redémarré." % target)
        return
    if cmd == "audit":
        try:
            n = int(sys.argv[2]) if len(sys.argv) > 2 else 50
        except ValueError:
            n = 50
        try:
            with open(AUDIT, "r", encoding="utf-8", errors="replace") as fh:
                lines = fh.readlines()[-n:]
            sys.stdout.write("".join(lines))
        except FileNotFoundError:
            print("Aucun audit.")
        return
    if cmd == "status":
        subprocess.run(["systemctl", "status", "marexssh", "--no-pager"], check=False)
        return
    usage()


if __name__ == "__main__":
    main()
