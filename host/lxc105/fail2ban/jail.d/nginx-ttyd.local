[nginx-ttyd]
enabled  = true
port     = http,https
filter   = nginx-ttyd
logpath  = /var/log/nginx/marexcode.access.log
maxretry = 5
findtime = 600
bantime  = 3600
# IP publique du serveur (hairpin/auto-tests) et loopback
ignoreip = 127.0.0.1/8 ::1 203.0.113.10 10.0.0.0/24 10.0.1.0/24 192.168.1.0/24
